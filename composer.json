{
    "name": "webmasterskaya/vk-teams-bot",
    "description": "Unofficial PHP SDK for the VK Teams Bot API",
    "homepage": "https://github.com/webmasterskaya/vk-teams-bot",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/webmasterskaya/vk-teams-bot/issues",
        "source": "https://github.com/webmasterskaya/vk-teams-bot"
    },
    "keywords": ["vk teams", "mail.ru", "bot", "api", "sdk"],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "php-http/discovery": "^1.20",
        "psr/event-dispatcher": "^1.0",
        "psr-discovery/event-dispatcher-implementations": "^1.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "guzzlehttp/guzzle": "^7.10",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "symfony/event-dispatcher": "^6.4 || ^7.0",
        "vimeo/psalm": "^6.16"
    },
    "autoload": {
        "psr-4": {
            "Webmasterskaya\\VkTeamsBot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webmasterskaya\\VkTeamsBot\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "lint": "php tests/lint.php",
        "cs:check": "php-cs-fixer check --diff --verbose",
        "cs:fix": "php-cs-fixer fix --verbose",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "psalm": "psalm --no-cache --no-progress",
        "analyse": [
            "@phpstan",
            "@psalm"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
